# Copier vers deploy/.env SUR LE SERVEUR. Ne jamais commiter deploy/.env.
IMAGE_PREFIX=ghcr.io/aymane-elb/tython
# Remplacer par sha- suivi du SHA complet d'un commit main publie par la CI.
IMAGE_TAG=
POSTGRES_USER=tython
POSTGRES_DB=tython
# Generer un nouveau secret avec : openssl rand -hex 24
POSTGRES_PASSWORD=
# Acces local uniquement par defaut. Sur la VM, mettre son IP privee
# pour acceder depuis le PC, ou utiliser le tunnel SSH documente.
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
